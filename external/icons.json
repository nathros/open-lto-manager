{
	"themes": {
		"tabler": {
			"path": "external/tabler-icons/",
			"repo": "https://github.com/tabler/tabler-icons",
			"action": "tab"
		},
		"remix": {
			"path": "external/remixicon/",
			"repo": "https://github.com/Remix-Design/remixicon",
			"action": "none"
		}
	},
	"icons": {
		"alert-error": {
			"tabler": "icons/filled/alert-octagon.svg",
			"remix": "icons/System/spam-2-fill.svg"
		},
		"alert-info": {
			"tabler": "icons/filled/info-circle.svg",
			"remix": "icons/System/information-fill.svg"
		},
		"alert-success": {
			"tabler": "icons/filled/circle-check.svg",
			"remix": "icons/System/checkbox-circle-fill.svg"
		},
		"alert-warning": {
			"tabler": "icons/filled/alert-triangle.svg",
			"remix": "icons/System/alert-fill.svg"
		},
		"home": {
			"tabler": "icons/filled/home.svg",
			"remix": "icons/Buildings/home-4-fill.svg"
		},
		"notification": {
			"tabler": "icons/filled/bell.svg",
			"remix": "icons/Media/notification-2-fill.svg"
		},
		"user": {
			"tabler": "icons/filled/user.svg",
			"remix": "icons/User & Faces/user-fill.svg"
		}
	}
}